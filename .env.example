# Finance Dashboard - Environment Configuration
# Copy this file to .env and fill in your API keys.
# NEVER commit the .env file to version control.

# Server
PORT=1234

# Finnhub (Required - primary stock/ETF provider)
# Get your free API key at https://finnhub.io/
FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# Financial Modeling Prep (Optional fallback)
# Get your free API key at https://financialmodelingprep.com/
FINANCIAL_MODELING_PREP_API_KEY=
FINANCIAL_MODELING_PREP_BASE_URL=https://financialmodelingprep.com/api/v3

# Alpha Vantage (Optional fallback)
# Get your free API key at https://www.alphavantage.co/
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co

# CoinGecko (Crypto data - demo API works without a key)
# Get your free API key at https://www.coingecko.com/
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Yahoo Finance (No API key required - enabled by default)
YAHOO_FINANCE_ENABLED=true

# CORS (comma-separated origins, leave empty to allow all)
CORS_ORIGIN=

# Admin token for cache clear endpoint (optional)
ADMIN_TOKEN=
