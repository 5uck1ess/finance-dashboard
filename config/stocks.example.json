      "coingecko": {
        "requestsPerMinute": 30,
        "delayBetweenRequests": 2000
      },
      "yahooFinance": {
        "requestsPerMinute": 20,
        "delayBetweenRequests": 3000
      }
    },
    "cacheExpiry": {
      "stocks": 300000,
      "crypto": 60000
    },
    "autoRefreshSeconds": 300,
    "snapshot": {
      "file": "config/dashboard-snapshot.json"
    }
